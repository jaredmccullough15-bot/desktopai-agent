# Elastic Beanstalk deployment exclusions
# This file tells EB what to ignore when deploying source code.

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Local database
bill_core.db
*.db

# Secrets and environment
.env

# Logs
logs/
*.log

# Dev and test artifacts
bill-core-deploy-clean/
bill-core-deploy.zip
test_*.py
*_test.py

# Worker releases (not needed for app server)
worker-packages/
worker_releases.json

# Build tools
build_eb_zip.py
