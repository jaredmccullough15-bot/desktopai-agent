{
  "_comment": "Starter system template for HealthSherpa. Copy and adapt per tenant.",
  "tenant_id": "examples",
  "workflow_id": "healthsherpa_starter",
  "workflow_name": "HealthSherpa Starter Template",
  "description": "Example showing HealthSherpa client verification configuration. Not a runnable workflow on its own.",
  "version": "1.0.0",
  "enabled": false,
  "tags": ["example", "healthsherpa"],
  "systems": [
    {
      "system_key": "healthsherpa",
      "system_name": "HealthSherpa",
      "base_url": "https://www.healthsherpa.com",
      "login_url": "https://www.healthsherpa.com/sign_in",
      "search_strategy": "url_param",
      "selectors": {
        "search_input": "#client-search",
        "results_container": ".clients-list",
        "result_row": "tr.client-row",
        "next_page_button": "a[rel='next']",
        "no_results_indicator": ".no-clients",
        "extra": {
          "agent_of_record": ".agent-of-record",
          "enrollment_status": ".enrollment-status"
        }
      },
      "extraction_fields": [
        {
          "field_key": "agent_of_record",
          "display_label": "Agent of Record",
          "selector": ".agent-of-record",
          "attribute": "textContent",
          "transform": "strip"
        },
        {
          "field_key": "enrollment_status",
          "display_label": "Enrollment Status",
          "selector": ".enrollment-status",
          "attribute": "textContent",
          "transform": "lowercase"
        },
        {
          "field_key": "marketplace_id",
          "display_label": "FFM Application ID",
          "selector": "td[data-field='application_id']",
          "attribute": "textContent",
          "transform": "strip"
        }
      ],
      "notes": "Bill Worker has a dedicated smart_sherpa_sync.py executor for HealthSherpa bulk client sync. For multi-page bulk runs, prefer that executor over generic browser_workflow steps."
    }
  ],
  "identity_policy": { "fields": [] },
  "actions": [],
  "decision_rules": [],
  "safety_policy": {
    "never_update_on_name_only": true,
    "require_identity_score_for_crm_actions": true,
    "dry_run_default": true,
    "require_human_approval_for_first_n_runs": 10,
    "screenshot_before_action": true,
    "screenshot_after_action": true,
    "audit_log_required": true,
    "duplicate_action_check_required": false
  }
}
